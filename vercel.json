{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run check && npm run build",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.lunico.dev"
        }
      ],
      "destination": "https://lunico.dev/:path*",
      "permanent": true
    }
  ]
}
